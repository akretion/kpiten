<odoo>
    <!-- KPI configs used for functional tests of the shiny dashboard -->

    <record id="sale_count_card" model="kt.dataset.line">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales" />
        <field name="kind">card</field>
        <field name="name">Sales Orders count</field>
        <field name="sequence">1</field>
        <field name="panel_id" ref="kpiten_commercial_data.panel_sale" />
        <field name="col_span">1</field>
        <field name="definition">where = "state not in ('draft', 'sent')"</field>
    </record>

    <record id="vendor_sum_graph" model="kt.dataset.line">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales" />
        <field name="kind">graph</field>
        <field name="name">Best vendors</field>
        <field name="sequence">2</field>
        <field name="panel_id" ref="kpiten_commercial_data.panel_sale" />
        <field name="col_span">2</field>
        <field name="definition">graph_type = "bar"
[x]
name = "user_id"
aggregation = "none"
[y]
name = "amount_untaxed"
aggregation = "sum"
</field>
    </record>

    <record id="monthly_sales_pivot" model="kt.dataset.line">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales" />
        <field name="kind">pivot</field>
        <field name="name">Monthly sales by salesperson</field>
        <field name="sequence">4</field>
        <field name="panel_id" ref="kpiten_commercial_data.panel_sale" />
        <field name="col_span">2</field>
        <field name="definition">index = "user_id"
column = "date_order.year"
measure = "amount_untaxed"
aggregation = "sum"
</field>
    </record>

    <record id="sale_purchases_union" model="kt.dataset.line">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales" />
        <field name="kind">union</field>
        <field name="name">Union sales et purchases</field>
        <field name="panel_id" ref="kpiten_commercial_data.panel_sale" />
        <field name="sequence">6</field>
        <field name="definition">union_model = "purchase.order"
[mapping."sale.order"]
name = "name"
amount_untaxed = "amount_untaxed"
[mapping."purchase.order"]
name = "name"
amount_untaxed = "amount_untaxed"
</field>
    </record>

    <!-- sale.order.line tiles -->
    <record id="top_products_graph" model="kt.dataset.line">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales_lines" />
        <field name="kind">graph</field>
        <field name="name">Best products (qty)</field>
        <field name="panel_id" ref="kpiten_commercial_data.panel_sale" />
        <field name="sequence">7</field>
        <field name="col_span">2</field>
        <field name="definition">graph_type = "bar"
[x]
name = "product_id"
aggregation = "none"
[y]
name = "product_uom_qty"
aggregation = "sum"
</field>
    </record>

    <record id="salesperson_qty_graph" model="kt.dataset.line">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales_lines" />
        <field name="kind">graph</field>
        <field name="name">Qty sold per salesperson</field>
        <field name="panel_id" ref="kpiten_commercial_data.panel_sale" />
        <field name="sequence">8</field>
        <field name="definition">graph_type = "area"
[x]
name = "salesman_id"
aggregation = "none"
[y]
name = "product_uom_qty"
aggregation = "sum"
</field>
    </record>

    <record id="product_best_category_card" model="kt.dataset.line">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales_lines" />
        <field name="kind">card</field>
        <field name="name">Best Category</field>
        <field name="panel_id" ref="kpiten_commercial_data.panel_sale" />
        <field name="sequence">25</field>
        <field name="definition">where = "state not in ('draft', 'sent', 'cancel')"
best = "product_id.categ_id"
measure = "price_subtotal"
detail = "product_uom_qty"
detail_label = "sold"
</field>
    </record>

    <!-- the two scorecards : the name of the best, its units sold under it -->
    <record id="product_best_seller_card" model="kt.dataset.line">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales_lines" />
        <field name="kind">card</field>
        <field name="name">Best Seller</field>
        <field name="panel_id" ref="kpiten_commercial_data.panel_sale" />
        <field name="sequence">24</field>
        <field name="definition">where = "state not in ('draft', 'sent', 'cancel')"
best = "product_id"
measure = "price_subtotal"
detail = "product_uom_qty"
detail_label = "sold"
</field>
    </record>

    <!-- purchases tiles -->
    <record id="vendor_purchased_graph" model="kt.dataset.line">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_purchases_lines" />
        <field name="kind">graph</field>
        <field name="name">Qty purchased</field>
        <field name="panel_id" ref="kpiten_commercial_data.panel_purchase" />
        <field name="sequence">1</field>
        <field name="definition">graph_type = "bar"
[x]
name = "product_id"
aggregation = "none"
[y]
name = "product_qty"
aggregation = "sum"
</field>
    </record>

    <record id="purchase_amount_spend_graph" model="kt.dataset.line">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_purchases" />
        <field name="kind">graph</field>
        <field name="name">Spend by vendor</field>
        <field name="panel_id" ref="kpiten_commercial_data.panel_purchase" />
        <field name="sequence">2</field>
        <field name="col_span">2</field>
        <field name="definition">graph_type = "bar"
[x]
name = "partner_id.commercial_partner_id"
aggregation = "none"
[y]
name = "amount_untaxed"
aggregation = "sum"
</field>
    </record>

    <record id="purchase_orders_pivot" model="kt.dataset.line">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_purchases" />
        <field name="kind">pivot</field>
        <field name="name">Monthly spend</field>
        <field name="panel_id" ref="kpiten_commercial_data.panel_purchase" />
        <field name="sequence">3</field>
        <field name="col_span">2</field>
        <field name="definition">index = "date_order"
column = "date_order.year"
measure = "amount_untaxed"
aggregation = "sum"
monthly = true
</field>
    </record>

    <!-- purchase KPI cards, like the Odoo purchase dashboard : {today} and
        {today-N} in a `where` are replaced by the date (N days back) -->
    <record id="purchase_rfq_to_send_card" model="kt.dataset.line">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_purchases" />
        <field name="kind">card</field>
        <field name="name">RFQs to send</field>
        <field name="panel_id" ref="kpiten_commercial_data.panel_purchase" />
        <field name="sequence">10</field>
        <field name="definition">where = "state = 'draft'"
ignore_period = true
</field>
    </record>

    <record id="purchase_rfq_waiting_card" model="kt.dataset.line">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_purchases" />
        <field name="kind">card</field>
        <field name="name">RFQs waiting</field>
        <field name="panel_id" ref="kpiten_commercial_data.panel_purchase" />
        <field name="sequence">11</field>
        <field
            name="definition"
        >where = "state = 'sent' and date_order &gt;= '{today}'"
ignore_period = true
</field>
    </record>

    <record id="purchase_rfq_late_card" model="kt.dataset.line">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_purchases" />
        <field name="kind">card</field>
        <field name="name">Late RFQs</field>
        <field name="panel_id" ref="kpiten_commercial_data.panel_purchase" />
        <field name="sequence">12</field>
        <field
            name="definition"
        >where = "state in ('draft', 'sent', 'to approve') and date_order &lt; '{today}'"
ignore_period = true
</field>
    </record>

    <record id="purchase_receipt_late_card" model="kt.dataset.line">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_purchases" />
        <field name="kind">card</field>
        <field name="name">Late receipts</field>
        <field name="panel_id" ref="kpiten_commercial_data.panel_purchase" />
        <field name="sequence">13</field>
        <field
            name="definition"
        >where = "state in ('purchase', 'done') and receipt_status in ('pending', 'partial') and date_planned &lt; '{today}'"
ignore_period = true
</field>
    </record>

    <record id="purchase_last_7_days_card" model="kt.dataset.line">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_purchases" />
        <field name="kind">card</field>
        <field name="name">Purchased last 7 days</field>
        <field name="panel_id" ref="kpiten_commercial_data.panel_purchase" />
        <field name="sequence">14</field>
        <field name="definition">where = "state in ('purchase', 'done') and date_approve &gt;= '{today-7}'"
aggregation = "sum"
measure = "amount_untaxed"
ignore_period = true
</field>
    </record>

    <record id="purchase_avg_order_value_card" model="kt.dataset.line">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_purchases" />
        <field name="kind">card</field>
        <field name="name">Avg order value</field>
        <field name="panel_id" ref="kpiten_commercial_data.panel_purchase" />
        <field name="sequence">15</field>
        <field name="definition">where = "state in ('purchase', 'done')"
aggregation = "mean"
measure = "amount_untaxed"
decimals = 0
compare = true
</field>
    </record>

    <record id="purchase_days_to_order_card" model="kt.dataset.line">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_purchases" />
        <field name="kind">card</field>
        <field name="name">Days to order</field>
        <field name="panel_id" ref="kpiten_commercial_data.panel_purchase" />
        <field name="sequence">16</field>
        <field name="definition">where = "state in ('purchase', 'done')"
aggregation = "mean"
measure = "days_to_order"
unit = "days"
compare = true
good = "down"  # fewer days is better
[derive]
days_to_order = "date_approve - create_date"
</field>
    </record>

    <record id="purchase_days_to_receive_card" model="kt.dataset.line">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_purchases" />
        <field name="kind">card</field>
        <field name="name">Days to receive</field>
        <field name="panel_id" ref="kpiten_commercial_data.panel_purchase" />
        <field name="sequence">17</field>
        <field name="definition">where = "state in ('purchase', 'done')"
aggregation = "mean"
measure = "days_to_receive"
unit = "days"
compare = true
good = "down"  # fewer days is better
[derive]
days_to_receive = "effective_date - date_approve"
</field>
    </record>


    <!-- Best Sellers by Revenue / by Units Sold : a bar per product, biggest first -->
    <record id="product_best_sellers_revenue_graph" model="kt.dataset.line">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales_lines" />
        <field name="kind">graph</field>
        <field name="name">Best Sellers by Revenue</field>
        <field name="panel_id" ref="kpiten_commercial_data.panel_sale" />
        <field name="sequence">30</field>
        <field name="col_span">3</field>
        <field name="tile_height">340</field>
        <field name="definition">graph_type = "bar"
where = "state not in ('draft', 'sent', 'cancel')"
[x]
name = "product_id"
aggregation = "none"
[y]
name = "price_subtotal"
aggregation = "sum"
</field>
    </record>

    <record id="product_best_sellers_units_graph" model="kt.dataset.line">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales_lines" />
        <field name="kind">graph</field>
        <field name="name">Best Sellers by Units Sold</field>
        <field name="panel_id" ref="kpiten_commercial_data.panel_sale" />
        <field name="sequence">31</field>
        <field name="col_span">3</field>
        <field name="tile_height">340</field>
        <field name="definition">graph_type = "bar"
where = "state not in ('draft', 'sent', 'cancel')"
[x]
name = "product_id"
aggregation = "none"
[y]
name = "product_uom_qty"
aggregation = "sum"
</field>
    </record>

    <!-- Best Selling Products (a link to each product), written in SQL (kpiten_core.sqltile) / Best Selling Categories -->
    <record id="product_best_selling_products_table" model="kt.dataset.line">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales_lines" />
        <field name="kind">data</field>
        <field name="name">Best Selling Products</field>
        <field name="panel_id" ref="kpiten_commercial_data.panel_sale" />
        <field name="sequence">32</field>
        <field name="col_span">2</field>
        <field name="tile_height">380</field>
        <field name="definition">-- d : the rows the user may read, already filtered by the panel period and dimensions
-- the confirmed orders, by product ; a "[label](url)" cell is a link to Odoo
SELECT
    '[' || "product_id" || '](' || :odoo_url || '/odoo/product.product/'
        || CAST("product_id_" AS VARCHAR) || ')' AS "Product",
    SUM("product_uom_qty") AS "Units",
    SUM("price_subtotal") AS "Revenue",
    "product_id_" AS "__product_id_"
FROM d
WHERE "state" NOT IN ('draft', 'sent', 'cancel') AND "product_id" IS NOT NULL
GROUP BY "product_id", "product_id_"
-- the product breaks the ties : a stable order
ORDER BY "Revenue" DESC, "product_id"
LIMIT 10</field>
        <field name="drill_definition">-- the order lines of the clicked product (:product_id_, the hidden column of the tile)
SELECT
    "order_id.date_order" AS "Date",
    '[' || "order_id" || '](' || :odoo_url || '/odoo/sale.order/'
        || CAST("order_id_" AS VARCHAR) || ')' AS "Order",
    "order_partner_id" AS "Customer",
    "product_id" AS "Product",
    "product_uom_qty" AS "Quantity",
    "price_subtotal" AS "Revenue"
FROM d
WHERE "state" NOT IN ('draft', 'sent', 'cancel') AND "product_id_" = :product_id_
ORDER BY "order_id.date_order" DESC, "id" DESC</field>
    </record>

