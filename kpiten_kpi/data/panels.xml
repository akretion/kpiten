<odoo>
    <record model="kt.panel" id="panel_sale">
        <field name="name">Sales</field>
        <field name="sequence">10</field>
        <field name="filter_config">[date]
field = ["date_order", "order_id.date_order"]

[[dimensions]]
name = "user_id"
label = "Salesperson"

[[dimensions]]
name = "partner_id"
label = "Customer"
</field>
    </record>
    <!-- the Odoo « Sales » dashboard (spreadsheet_dashboard_sale) and nothing else,
         in its order : to compare the figures and the speed of both. Its tiles are
         the KPI of tiles_sale.xml (the same KPI, see data/tiles_odoo_sales.xml) -->
    <record model="kt.panel" id="panel_odoo_sales">
        <field name="name">Sales (Odoo)</field>
        <field name="sequence">15</field>
        <field name="filter_config">[date]
field = ["date_order", "order_id.date_order"]

[[dimensions]]
name = "user_id"
label = "Salesperson"

[[dimensions]]
name = "partner_id"
label = "Customer"
</field>
    </record>
    <record model="kt.panel" id="panel_purchase">
        <field name="name">Purchase</field>
        <field name="sequence">20</field>
        <field name="filter_config">[date]
field = "date_order"

[[dimensions]]
name = "partner_id"
label = "Vendor"
</field>
    </record>

</odoo>
