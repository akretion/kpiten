<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- the tiles of the « Sales (Odoo) » panel : the KPI of tiles_sale.xml (not
        copies : a change of a KPI shows on both panels), in the order of the Odoo
        « Sales » dashboard : the four scorecards, Monthly Sales, then the tables
        two by two (col_span 2 : half the width) -->

    <record id="odoo_sales_quotations_card_tile" model="kt.panel.tile">
        <field name="panel_id" ref="panel_odoo_sales" />
        <field name="kpi_id" ref="sale_quotations_card" />
        <field name="sequence">1</field>
    </record>
