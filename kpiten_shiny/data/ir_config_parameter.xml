<odoo noupdate="1">
    <record model="ir.config_parameter" id="kpiten_shiny_setting_service">
        <field name="key">kpiten_shiny_service</field>
        <!-- internal_url : where Odoo asks for a session (SSO) ;
             external_url : what the browser of the user opens -->
        <field
            name="value"
        >{"application": "Shiny", "external_url": "http://localhost:5000", "internal_url": "http://localhost:5000"}</field>
    </record>
</odoo>
