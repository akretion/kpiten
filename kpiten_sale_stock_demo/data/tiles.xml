<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- Sales KPI cards, the four scorecards of the Odoo "Sales" dashboard
        (spreadsheet_dashboard_sale) : same states and measures, the period of
        the panel plays the role of Odoo's Period filter. On the demo data
        they give the same figures as Odoo's dashboard for any period. -->

    <record id="sale_quotations_card" model="kt.dataset.line">
        <field name="dataset_id" ref="kpiten_demo.kpiten_sales" />
        <field name="kind">card</field>
        <field name="name">Quotations</field>
        <field name="panel_id" ref="kpiten_demo.panel_sale" />
        <field name="sequence">20</field>
        <field name="definition">where = "state in ('draft', 'sent')"
</field>
    </record>

    <record id="sale_orders_card" model="kt.dataset.line">
        <field name="dataset_id" ref="kpiten_demo.kpiten_sales" />
        <field name="kind">card</field>
        <field name="name">Orders</field>
        <field name="panel_id" ref="kpiten_demo.panel_sale" />
        <field name="sequence">21</field>
        <field name="definition">where = "state = 'sale'"
</field>
    </record>

    <record id="sale_revenue_card" model="kt.dataset.line">
        <field name="dataset_id" ref="kpiten_demo.kpiten_sales" />
        <field name="kind">card</field>
        <field name="name">Revenue</field>
        <field name="panel_id" ref="kpiten_demo.panel_sale" />
        <field name="sequence">22</field>
        <field name="definition">where = "state = 'sale'"
aggregation = "sum"
measure = "amount_untaxed"
unit = "$"
</field>
    </record>

    <record id="sale_avg_order_card" model="kt.dataset.line">
        <field name="dataset_id" ref="kpiten_demo.kpiten_sales" />
        <field name="kind">card</field>
        <field name="name">Average Order</field>
        <field name="panel_id" ref="kpiten_demo.panel_sale" />
        <field name="sequence">23</field>
        <field name="definition">where = "state = 'sale'"
aggregation = "mean"
measure = "amount_untaxed"
decimals = 0
unit = "$"
</field>
    </record>

    <!-- the "Monthly sales" chart of the same dashboard : revenue of the
        confirmed orders per month, as a filled line, full width -->
    <record id="sale_monthly_sales_graph" model="kt.dataset.line">
        <field name="dataset_id" ref="kpiten_demo.kpiten_sales" />
        <field name="kind">graph</field>
        <field name="name">Monthly sales</field>
        <field name="panel_id" ref="kpiten_demo.panel_sale" />
        <field name="sequence">1</field>
        <field name="col_span">3</field>
        <field name="tile_height">340</field>
        <field name="definition">graph_type = "area"
where = "state not in ('draft', 'cancel', 'sent')"
monthly = true
[x]
name = "date_order"
aggregation = "none"
[y]
name = "amount_untaxed"
aggregation = "sum"
</field>
    </record>

    <!-- "Top Sales Orders" of the same dashboard : the ten confirmed orders
        with the biggest untaxed amount (then invoice status, then the default
        order of sale.order), with the panel period -->
    <record id="sale_top_orders_table" model="kt.dataset.line">
        <field name="dataset_id" ref="kpiten_demo.kpiten_sales" />
        <field name="kind">data</field>
        <field name="name">Top Sales Orders</field>
        <field name="panel_id" ref="kpiten_demo.panel_sale" />
        <field name="sequence">5</field>
        <field name="col_span">2</field>
        <field name="tile_height">380</field>
        <field name="definition">d_next = d
d_next = d_next.filter(~pl.col("state").is_in(["draft", "sent", "cancel"]))
d_next = d_next.sort(["amount_untaxed", "invoice_status", "date_order", "id"], descending=[True, False, True, True]).head(10)
d_next = d_next.select(["partner_id", "user_id", "amount_untaxed"]).rename({"partner_id": "Customer", "user_id": "Salesperson", "amount_untaxed": "Revenue"})</field>
    </record>
</odoo>
