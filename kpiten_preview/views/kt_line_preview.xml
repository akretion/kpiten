<odoo>
    <record id="kt_dataset_line_preview_form" model="ir.ui.view">
        <field name="model">kt.dataset.line.preview</field>
        <field name="arch" type="xml">
            <form>
                <field name="line_id" invisible="1" />
                <div class="d-flex align-items-center gap-2 mb-3">
                    <field name="size" class="w-auto" />
                    <button
                        name="action_refresh"
                        type="object"
                        string="Refresh"
                        icon="fa-refresh"
                        class="btn-secondary"
                    />
                </div>
                <field name="preview_html" nolabel="1" />
                <footer>
                    <button string="Close" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="kt_dataset_line_form_preview" model="ir.ui.view">
        <field name="model">kt.dataset.line</field>
        <field name="inherit_id" ref="kpiten.kt_dataset_line_form" />
        <field name="arch" type="xml">
            <xpath expr="//form/group" position="before">
                <header>
                    <button
                        name="action_preview"
                        type="object"
                        string="Preview"
                        icon="fa-eye"
                        class="btn-primary"
                        invisible="not id"
                    />
                </header>
            </xpath>
        </field>
    </record>
</odoo>
