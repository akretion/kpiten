<odoo noupdate="1">
    <record model="ir.config_parameter" id="kpiten_marimo_setting_service">
        <field name="key">kpiten_marimo_service</field>
        <!-- internal_url : where Odoo asks for a session (SSO) ;
             external_url : what the browser of the user opens -->
        <field
            name="value"
        >{"application": "Marimo", "external_url": "http://localhost:5002", "internal_url": "http://localhost:5002"}</field>
    </record>
</odoo>
