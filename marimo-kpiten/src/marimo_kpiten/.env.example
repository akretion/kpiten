# the data_dir folder can be safely deleted, but keeping it means you will have a snapshot
# of the last time you've imported your files. Do not put a trailing slash.
# defaults to "./" in the app.

# ODOO RELATED
ODOO_HOST=localhost
ODOO_PORT=8069
ODOO_DB=mydb
ODOO_LOGIN=admin
ODOO_PWD=admin

DATA_PATH="../data_dir" # where all data generated by kpiten will be stored to and read from.

DECIMAL_TRUNCATE = 5