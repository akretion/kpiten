# the generated folder can be safely deleted, but keeping it means you will have a snapshot
# of the last time you've imported your files. Do not put a trailing slash.
# defaults to "./" in the app.

# DB
DB_USER=sql
DB_PWD=any
DB_HOST=localhost
DB_PORT=5432

# ODOO RELATED
ODOO_HOST=localhost
ODOO_PORT=8069
ODOO_DB=db
ODOO_LOGIN=admin
ODOO_PWD=admin

DATA_PATH="../generated" # where all data generated by kpiten will be stored to and read from.