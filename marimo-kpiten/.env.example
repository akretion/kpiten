POSTGRES_URL=postgresql://username:password@domain:port/db_name
ODOO_API_KEY=<your odoo user's API KEY>
KPITEN_PORT=5000

# ODOO RELATED
ODOO_SERVER_HOST=localhost
ODOO_SERVER_PORT=8069
ODOO_DB_NAME=db
ODOO_UNAME=admin
ODOO_PWD=admin

# the generated files can be safely deleted, but keeping them means you will have a snapshot
# of the last time you've imported your files. Do not put a trailing slash.
TABLE_PATH=<the path where database parquet files will be stored>