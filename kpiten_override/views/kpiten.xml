<odoo>
    <record id="kpiten_form" model="ir.ui.view">
        <field name="model">kt.dataset</field>
        <field name="inherit_id" ref="kpiten.kpiten_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']/kanban" position="before">
                <list>
                    <field name="sequence" widget="handle" />
                    <field name="name" />
                    <field name="kind" />
                    <field name="col_span" />
                    <field name="tile_height" />
                    <field name="group_ids" widget="many2many_tags" />
                    <field name="active" widget="boolean_toggle" />
                </list>
            </xpath>
        </field>
    </record>
</odoo>
