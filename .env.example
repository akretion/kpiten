# Environnement de bi/ : lu par le Makefile et par scripts/kpiten-stack.
# Copier en .env (ignoré par git). Pas de guillemets ni de `$` : le Makefile les
# lirait tels quels.
# Ce n'est pas le .env des apps (src/kpiten-core/.env, voir plus bas).

# Mot de passe PostgreSQL de l'utilisateur odoo (odoo.conf n'en contient pas)
PGPASSWORD=

# ---- .env des applications (src/kpiten-core/.env) ----
# ODOO RELATED
ODOO_HOST=localhost
ODOO_PORT=8069
ODOO_DB=kpiten
ODOO_LOGIN=admin
ODOO_PWD=admin

# where all data generated by kpiten will be stored to and read from.
# Do not put a trailing slash. Defaults to "./data_dir".
DATA_PATH=data_dir

# Initial-load JSONL staging dir : Odoo writes raw chunks there (system
# parameter `kpiten_staging_dir`), the app reads them back to consolidate the
# final parquets. Must be a path on the shared volume, under DATA_PATH. The
# value is read from Odoo (`Backend.get_staging_dir`), not from this file.
# STAGING_DIR=

DECIMAL_TRUNCATE = 5

# Odoo RPC timeout in seconds (raise from odoorpc's 120s default so a slow
# chunked extract doesn't hard-fail mid-sync).
ODOO_TIMEOUT=300

# Rows read per SQL query during the parquet sync (about one block of
# PARTITION_SIZE ids : fewer, bigger queries are much faster than many small ones).
SYNC_PAGE_SIZE=100000

# Records pulled per background completion pass (recent->oldest initial load).
SYNC_BATCH_SIZE=50000

# Seconds between two background completion passes in the dashboard apps.
SYNC_INTERVAL=60

# Secret partagé avec le module Odoo kpiten (src/kpiten-addons/.env.example) :
# il doit être identique des deux côtés.
SHARED_AUTH_SECRET="passphrase"

# Records per stored parquet block (id // PARTITION_SIZE) : a sync holds one
# block at a time, a delta only rewrites the blocks it touches.
PARTITION_SIZE=100000

# Garde-fous de sortie des tuiles (un tableau ou un graphe géant fige le navigateur)
# TILE_MAX_ROWS=500
# TILE_MAX_CATEGORIES=50
# TILE_MAX_POINTS=1000
# TILE_MAX_PIVOT_COLUMNS=100
# DIMENSION_MAX_VALUES=1000

# Explore (téléchargement des lignes d'un panel pour marimo)
# EXPLORE_MAX_ROWS=500000   # lignes par table
# EXPLORE_DIR=              # défaut : explore/ à côté de DATA_PATH
# EXPLORE_TTL_HOURS=1       # purge des exports oubliés
