<odoo noupdate="1">
    <record model="kt.panel" id="panel_sale">
        <field name="name">Sales</field>
        <field
            name="filter_config"
        >{"date": {"field": ["date_order", "order_id.date_order"]}, "dimensions": [{"name": "user_id.name", "label": "Salesperson"}, {"name": "partner_id.name", "label": "Customer"}]}</field>
    </record>
    <record model="kt.panel" id="panel_purchase">
        <field name="name">Purchase</field>
        <field
            name="filter_config"
        >{"date": {"field": "date_order"}, "dimensions": [{"name": "partner_id.name", "label": "Vendor"}]}</field>
    </record>
</odoo>
