<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- runs the generation queued by the button of the configuration (triggered by
         it ; the daily call finds nothing queued) -->
    <record id="ir_cron_generate_demo" model="ir.cron">
        <field name="name">KpiTen : generate the demo sales</field>
        <field name="model_id" ref="kpiten.model_kt_config" />
        <field name="state">code</field>
        <field name="code">model._cron_generate_demo()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True" />
    </record>
</odoo>
