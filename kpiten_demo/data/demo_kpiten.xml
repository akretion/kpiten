<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="kpiten_sales" model="kpiten.config">
        <field name="model_id" ref="sale.model_sale_order" />
    </record>

    <record id="sale_count_card" model="kpiten.config.line">
        <field name="config_id" ref="kpiten_sales" />
        <field name="kind">card</field>
        <field name="name">Sales Orders count</field>
        <field name="sequence">1</field>
        <field name="panel_id" ref="panel_sale" />
        <field name="definition">where = "state not in ('draft', 'sent')"</field>
    </record>

    <record id="vendor_sum_graph" model="kpiten.config.line">
        <field name="config_id" ref="kpiten_sales" />
        <field name="kind">graph</field>
        <field name="name">Best vendors</field>
        <field name="panel_id" ref="panel_sale" />
        <field name="sequence">2</field>
        <field name="definition">graph_type = "bar"
from = "sale.order"
[x]
name = "user_id.name"
aggregation = "none"
[y]
name = "amount_untaxed"
aggregation = "sum"
</field>
    </record>

    <record id="ammount_untaxed_df" model="kpiten.config.line">
        <field name="config_id" ref="kpiten_sales" />
        <field name="kind">data</field>
        <field name="name">Amount untaxed</field>
        <field name="panel_id" ref="panel_sale" />
        <field name="sequence">2</field>
        <field name="definition">d_next = d
d_next = d_next.select([pl.col("amount_untaxed").sum().alias("amount_untaxed_sum")])</field>
    </record>

    <record id="sale_purchases_union" model="kpiten.config.line">
        <field name="config_id" ref="kpiten_sales" />
        <field name="kind">union</field>
        <field name="name">Union sales et puchases</field>
        <field name="panel_id" ref="panel_sale" />
        <field name="sequence">6</field>
        <field name="definition">union_model = "purchase.order"
[mapping."sale.order"]
name = "name"
amount_untaxed = "amount_untaxed"
[mapping."purchase.order"]
name = "name"
amount_untaxed = "amount_untaxed"
</field>
    </record>

    <record id="kpiten_purchases" model="kpiten.config">
        <field name="model_id" ref="purchase.model_purchase_order" />
    </record>

</odoo>
