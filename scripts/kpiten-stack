#!/usr/bin/env bash
# Start / stop / restart the local kpiten stack :
#   odoo    :8069   (src/odoo + odoo.conf, serves the databases matching KPITEN_DB_FILTER)
#   shiny   :5000   (src/shiny-kpiten)
#   nicegui :5001   (src/nicegui-kpiten)
#   marimo  :5002   (src/marimo-kpiten)
#
# Usage : scripts/kpiten-stack {start|stop|restart|status} [odoo|shiny|nicegui|marimo|all]
#
# A service is found by the port it listens on (never by a name pattern), and
# logs go to data/logs/{odoo,shiny,nicegui,marimo}.log (appended ; rotated at start past KPITEN_LOG_MAX bytes), and shiny
# dumps the html of its tiles there (kpiten_tiles.html). Environment :
#   KPITEN_DB_FILTER  Odoo db filter, default '^(big|dash)$'
#   KPITEN_LOG_MAX    size in bytes above which a log is rotated at start (log.1 .. log.3), default 5242880
#   PGPASSWORD        Postgres password of the odoo user (odoo.conf has none) : set it in .env
#   ALLOW_RPC_USER=1  passed through : dashboards usable without SSO (dev only)
set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# .env of bi/ (see .env.example) : PGPASSWORD, and any variable above
if [ -f "$ROOT/.env" ]; then
    set -a
    . "$ROOT/.env"
    set +a
fi

DB_FILTER="${KPITEN_DB_FILTER:-^(big|dash)$}"
SERVICES=(odoo shiny nicegui marimo)

port_of() {
    case $1 in
        odoo) echo 8069 ;;
        shiny) echo 5000 ;;
        nicegui) echo 5001 ;;
        marimo) echo 5002 ;;
    esac
}

# path that answers once the service is up (any http status counts)
probe_of() {
    case $1 in
        odoo) echo /web/login ;;
        *) echo / ;;
    esac
}

LOG_DIR="$ROOT/data/logs"
LOG_MAX="${KPITEN_LOG_MAX:-5242880}"
# read by shiny-kpiten : where it dumps the html of its tiles
export KPITEN_LOG_DIR="$LOG_DIR"
log_of() { echo "$LOG_DIR/$1.log"; }

# pid of the process listening on a port (empty when nothing does)
listener_pid() {
    ss -ltnp "sport = :$1" 2>/dev/null | grep -o 'pid=[0-9]*' | head -1 | cut -d= -f2
}

# a log past LOG_MAX bytes becomes log.1 (log.1 -> log.2 -> log.3, the last one is dropped)
rotate_log() {
    local file=$1 i
    [ -f "$file" ] || return 0
    [ "$(stat -c %s "$file")" -gt "$LOG_MAX" ] || return 0
    for i in 2 1; do
        [ -f "$file.$i" ] && mv "$file.$i" "$file.$((i + 1))"
    done
    mv "$file" "$file.1"
}

# the service command itself, run in the foreground (`_run` below detaches it)
run_service() {
    case $1 in
        odoo)
            # relative addons_path / data_dir of odoo.conf : run from the root
            cd "$ROOT" || exit 1
            exec .venv/bin/python src/odoo/odoo-bin -c odoo.conf --db-filter "$DB_FILTER"
            ;;
        shiny)
            cd "$ROOT/src/shiny-kpiten" || exit 1
            exec .venv/bin/python -m uvicorn \
                shiny_kpiten.main:this_app --host 0.0.0.0 --port 5000
            ;;
        nicegui)
            cd "$ROOT/src/nicegui-kpiten" || exit 1
            exec .venv/bin/python -m nicegui_kpiten.main
            ;;
        marimo)
            cd "$ROOT/src/marimo-kpiten" || exit 1
            exec .venv/bin/python -m uvicorn \
                marimo_kpiten.main:this_app --host 0.0.0.0 --port 5002
            ;;
    esac
}

start_one() {
    local name=$1 port i
    port=$(port_of "$name")
    if [ -n "$(listener_pid "$port")" ]; then
        echo "$name: already listening on :$port"
        return 0
    fi
    mkdir -p "$LOG_DIR"
    rotate_log "$(log_of "$name")"
    # detached from this shell (own session) : it survives the script and the
    # terminal that started it
    nohup setsid "$0" _run "$name" >>"$(log_of "$name")" 2>&1 </dev/null &
    for i in $(seq 1 60); do
        if curl -s -o /dev/null -m 2 "http://localhost:$port$(probe_of "$name")"; then
            echo "$name: up on :$port (log $(log_of "$name"))"
            return 0
        fi
        sleep 1
    done
    echo "$name: no answer on :$port after 60 s, see $(log_of "$name")" >&2
    return 1
}

stop_one() {
    local name=$1 port pid i
    port=$(port_of "$name")
    pid=$(listener_pid "$port")
    if [ -z "$pid" ]; then
        echo "$name: not running"
        return 0
    fi
    kill "$pid"
    for i in $(seq 1 30); do
        if [ -z "$(listener_pid "$port")" ]; then
            echo "$name: stopped"
            return 0
        fi
        sleep 1
    done
    echo "$name: still listening on :$port after 30 s (pid $pid), not forced" >&2
    return 1
}

status_one() {
    local name=$1 port pid code
    port=$(port_of "$name")
    pid=$(listener_pid "$port")
    if [ -z "$pid" ]; then
        echo "$name: down (:$port)"
        return 1
    fi
    code=$(curl -s -o /dev/null -m 3 -w '%{http_code}' "http://localhost:$port$(probe_of "$name")")
    echo "$name: up on :$port, pid $pid, http $code"
}

usage() {
    echo "usage: $(basename "$0") {start|stop|restart|status} [odoo|shiny|nicegui|marimo|all]" >&2
    exit 2
}

cmd=${1:-status}
target=${2:-all}

# hidden : how a service is launched (see start_one)
if [ "$cmd" = _run ]; then
    run_service "$target"
    exit 1
fi

case $target in
    all) selected=("${SERVICES[@]}") ;;
    odoo | shiny | nicegui | marimo) selected=("$target") ;;
    *) usage ;;
esac

# stop in reverse order (apps before Odoo), start in order
reverse() {
    local i
    for ((i = ${#selected[@]} - 1; i >= 0; i--)); do echo "${selected[i]}"; done
}

rc=0
case $cmd in
    start) for s in "${selected[@]}"; do start_one "$s" || rc=1; done ;;
    stop) for s in $(reverse); do stop_one "$s" || rc=1; done ;;
    restart)
        for s in $(reverse); do stop_one "$s" || rc=1; done
        for s in "${selected[@]}"; do start_one "$s" || rc=1; done
        ;;
    status) for s in "${selected[@]}"; do status_one "$s" || rc=1; done ;;
    *) usage ;;
esac
exit $rc
