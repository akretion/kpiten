<odoo>
    <!-- one tile per kind and option of the syntax (version 2, the union in version 1) : see the comment of each -->

    <!-- card : a count (the default aggregation) of the rows `where` keeps -->
    <record id="card_count" model="kt.kpi">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales" />
        <field name="kind">card</field>
        <field name="name">Count</field>
        <field name="panel_id" ref="panel_essential" />
        <field name="sequence">1</field>
        <field name="definition">where = "state = 'sale'"</field>
    </record>

    <!-- card : a sum, in the currency of the company, compared with the previous period -->
    <record id="card_sum" model="kt.kpi">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales" />
        <field name="kind">card</field>
        <field name="name">Sum</field>
        <field name="panel_id" ref="panel_essential" />
        <field name="sequence">2</field>
        <field name="definition">where = "state = 'sale'"
measure = "amount_untaxed"
aggregation = "sum"
unit = "currency"
compare = true
</field>
    </record>

    <!-- card : a mean (no decimal unless `decimals` asks for some) -->
    <record id="card_mean" model="kt.kpi">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales" />
        <field name="kind">card</field>
        <field name="name">Mean</field>
        <field name="panel_id" ref="panel_essential" />
        <field name="sequence">3</field>
        <field name="definition">where = "state = 'sale'"
measure = "amount_untaxed"
aggregation = "mean"
unit = "currency"
decimals = 0
</field>
    </record>

    <!-- card : the other aggregations (median, min, max) are written the same -->
    <record id="card_median" model="kt.kpi">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales" />
        <field name="kind">card</field>
        <field name="name">Median</field>
        <field name="panel_id" ref="panel_essential" />
        <field name="sequence">4</field>
        <field name="definition">where = "state = 'sale'"
measure = "amount_untaxed"
aggregation = "median"
unit = "currency"
</field>
    </record>

    <!-- card : a column computed from two dates (`[computed]`), where fewer is better (`[compare] good`) -->
    <record id="card_derive" model="kt.kpi">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_purchases" />
        <field name="kind">card</field>
        <field name="name">Derived column</field>
        <field name="panel_id" ref="panel_essential" />
        <field name="sequence">5</field>
        <field name="definition">where = "state in ('purchase', 'done')"
measure = "days_to_order"
aggregation = "mean"
unit = "days"

[compare]
good = "down"

[computed]
days_to_order = "date_approve - create_date"
</field>
    </record>

    <!-- card : the period of the panel does not apply (what is waiting now) -->
    <record id="card_ignore_period" model="kt.kpi">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales" />
        <field name="kind">card</field>
        <field name="name">Ignore period</field>
        <field name="panel_id" ref="panel_essential" />
        <field name="sequence">6</field>
        <field name="definition">where = "state = 'draft'"
ignore_period = true
</field>
    </record>

    <!-- card : `from` reads another table of the store than the one of its dataset
         (a sale tile counting the draft purchases) -->
    <record id="card_from" model="kt.kpi">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales" />
        <field name="kind">card</field>
        <field name="name">Draft purchases (from)</field>
        <field name="panel_id" ref="panel_essential" />
        <field name="sequence">7</field>
        <field name="definition">where = "state = 'draft'"
from = "purchase.order"
</field>
    </record>

    <!-- card : the best group (`by`) by `measure`, with a line under it (`[detail]`) -->
    <record id="card_best" model="kt.kpi">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales_lines" />
        <field name="kind">card</field>
        <field name="name">Best</field>
        <field name="panel_id" ref="panel_essential" />
        <field name="sequence">8</field>
        <field name="definition">where = "state not in ('draft', 'sent', 'cancel')"
measure = "price_subtotal"
by = "product_id"

[detail]
measure = "product_uom_qty"
label = "sold"
</field>
    </record>

    <!-- graph : bars, one per value of `by`, `measure` summed ; `[labels]` renames a column -->
    <record id="graph_bar" model="kt.kpi">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales" />
        <field name="kind">graph</field>
        <field name="name">Graph bar</field>
        <field name="panel_id" ref="panel_essential" />
        <field name="sequence">9</field>
        <field name="col_span">2</field>
        <field name="definition">type = "bar"
where = "state = 'sale'"
by = "partner_id"
measure = "amount_untaxed"
aggregation = "sum"

[labels]  # the names shown ; without it, the labels of the fields in Odoo
amount_untaxed = "HT"
</field>
    </record>

    <!-- graph : past the limit of bars, the rest is one « others » bar -->
    <record id="graph_bar_others" model="kt.kpi">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales" />
        <field name="kind">graph</field>
        <field name="name">Graph bar with others</field>
        <field name="panel_id" ref="panel_essential" />
        <field name="sequence">10</field>
        <field name="col_span">2</field>
        <field name="definition">type = "bar"
where = "state = 'sale'"
by = "partner_id"
measure = "amount_untaxed"
aggregation = "sum"
others = true
</field>
    </record>

    <!-- graph : an area over the months (`grain` groups the dates by month) -->
    <record id="graph_area_monthly" model="kt.kpi">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales" />
        <field name="kind">graph</field>
        <field name="name">Graph area monthly</field>
        <field name="panel_id" ref="panel_essential" />
        <field name="sequence">11</field>
        <field name="col_span">2</field>
        <field name="definition">type = "area"
where = "state = 'sale'"
by = "date_order"
grain = "month"
measure = "amount_untaxed"
aggregation = "sum"
</field>
    </record>

    <!-- graph : points (a scatter), `measure` counted -->
    <record id="graph_point" model="kt.kpi">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales_lines" />
        <field name="kind">graph</field>
        <field name="name">Graph point</field>
        <field name="panel_id" ref="panel_essential" />
        <field name="sequence">12</field>
        <field name="col_span">2</field>
        <field name="definition">type = "point"
by = "salesman_id"
measure = "id"
aggregation = "count"
</field>
    </record>

    <!-- graph : `series` splits each bar by a column (one color per value), `stacked` piles them -->
    <record id="graph_series_stacked" model="kt.kpi">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales" />
        <field name="kind">graph</field>
        <field name="name">Graph series stacked</field>
        <field name="panel_id" ref="panel_essential" />
        <field name="sequence">12</field>
        <field name="col_span">2</field>
        <field name="definition">type = "bar"
by = "user_id"
series = "state"
stacked = true
measure = "amount_untaxed"
aggregation = "sum"
</field>
    </record>

    <!-- graph : a `line` per salesperson over the months -->
    <record id="graph_line_series" model="kt.kpi">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales" />
        <field name="kind">graph</field>
        <field name="name">Graph line per series</field>
        <field name="panel_id" ref="panel_essential" />
        <field name="sequence">12</field>
        <field name="col_span">2</field>
        <field name="definition">type = "line"
where = "state = 'sale'"
by = "date_order"
grain = "month"
series = "user_id"
measure = "amount_untaxed"
aggregation = "sum"
</field>
    </record>

    <!-- graph : a `pie`, the `limit` biggest slices and the rest in « Others » -->
    <record id="graph_pie" model="kt.kpi">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales" />
        <field name="kind">graph</field>
        <field name="name">Graph pie</field>
        <field name="panel_id" ref="panel_essential" />
        <field name="sequence">12</field>
        <field name="col_span">2</field>
        <field name="definition">type = "pie"
where = "state = 'sale'"
by = "partner_id"
measure = "amount_untaxed"
aggregation = "sum"
limit = 8
others = true
</field>
    </record>

    <!-- graph : horizontal bars (`orientation`) for long labels ; `[plotly]` says what kpiten does not -->
    <record id="graph_horizontal" model="kt.kpi">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales" />
        <field name="kind">graph</field>
        <field name="name">Graph horizontal</field>
        <field name="panel_id" ref="panel_essential" />
        <field name="sequence">12</field>
        <field name="col_span">2</field>
        <field name="definition">type = "bar"
orientation = "h"
where = "state = 'sale'"
by = "partner_id"
measure = "amount_untaxed"
aggregation = "sum"
limit = 10

[plotly.layout]  # given as is to plotly update_layout
bargap = 0.4
</field>
    </record>

    <!-- graph : `from` the lines of the orders, the products being on the lines only -->
    <record id="graph_from_lines" model="kt.kpi">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales" />
        <field name="kind">graph</field>
        <field name="name">Products of the orders (from)</field>
        <field name="panel_id" ref="panel_essential" />
        <field name="sequence">12</field>
        <field name="definition">type = "bar"
from = "sale.order.line"  # the products are on the lines of the orders
where = "state = 'sale'"
by = "product_id"
measure = "price_subtotal"
aggregation = "sum"
limit = 10
</field>
    </record>

    <!-- pivot : `rows` × `columns` (here a derived `.year`) ; the header of the rows is the label of the field in Odoo ; `[table]` : format, totals, heatmap, note -->
    <record id="pivot" model="kt.kpi">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales" />
        <field name="kind">pivot</field>
        <field name="name">Pivot</field>
        <field name="panel_id" ref="panel_essential" />
        <field name="sequence">13</field>
        <field name="col_span">2</field>
        <field name="definition">rows = "user_id"
columns = "date_order.year"
measure = "amount_untaxed"
aggregation = "sum"

[table]  # how the table is drawn (great_tables)
format = "currency"
totals = true  # a « Total » row
row_totals = true  # a « Total » column
heatmap = true  # the cells colored by their value
note = "Untaxed amounts, every order"
</field>
    </record>

    <!-- pivot : the dates of the rows grouped by month (`grain`) -->
    <record id="pivot_monthly" model="kt.kpi">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_purchases" />
        <field name="kind">pivot</field>
        <field name="name">Pivot monthly</field>
        <field name="panel_id" ref="panel_essential" />
        <field name="sequence">14</field>
        <field name="col_span">2</field>
        <field name="definition">rows = "date_order"
columns = "date_order.year"
measure = "amount_untaxed"
aggregation = "sum"
grain = "month"
</field>
    </record>

    <!-- union (version 1) : the rows of two models, their columns mapped to the same names -->
    <record id="union" model="kt.kpi">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales" />
        <field name="kind">union</field>
        <field name="name">Union</field>
        <field name="panel_id" ref="panel_essential" />
        <field name="sequence">15</field>
        <field name="col_span">2</field>
        <field name="definition">union_model = "purchase.order"
[mapping."sale.order"]
name = "name"
amount_untaxed = "amount_untaxed"
[mapping."purchase.order"]
name = "name"
amount_untaxed = "amount_untaxed"
</field>
    </record>

    <!-- data : SQL on `d` ; a « [label](url) » cell is a link, a `__` column is hidden ; a header of TOML comments ([labels], [table]) -->
    <record id="data_sql" model="kt.kpi">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales_lines" />
        <field name="kind">data</field>
        <field name="name">Data in SQL</field>
        <field name="panel_id" ref="panel_essential" />
        <field name="sequence">16</field>
        <field name="col_span">2</field>
        <field name="tile_height">380</field>
        <field name="definition">-- d : the rows the user may read, already filtered by the panel period and dimensions
SELECT
    '[' || "product_id" || '](' || :odoo_url || '/odoo/product.product/'
        || CAST("product_id_" AS VARCHAR) || ')' AS "Product",
    SUM("product_uom_qty") AS "Units",
    SUM("price_subtotal") AS "Revenue",
    "product_id_" AS "__product_id_"
FROM d
WHERE "state" NOT IN ('draft', 'sent', 'cancel') AND "product_id" IS NOT NULL
GROUP BY "product_id", "product_id_"
-- the product breaks the ties : a stable order
ORDER BY "Revenue" DESC, "product_id"
LIMIT 10</field>
        <field name="drill_definition">-- the lines of the clicked product : its hidden column __product_id_ is :product_id_
SELECT "order_id.date_order" AS "Date", "order_id" AS "Order", "order_partner_id" AS "Customer",
    "product_uom_qty" AS "Quantity", "price_subtotal" AS "Revenue"
FROM d
WHERE "product_id_" = :product_id_ AND "state" NOT IN ('draft', 'sent', 'cancel')
ORDER BY "Date" DESC</field>
        <field name="display"># the header below (TOML in comments) : the names shown and how the table is drawn
[labels]
Units = "Quantité"
[table]
totals = true  # a « Total » row
heatmap = true
[table.columns]
Revenue = { format = "currency" }</field>
    </record>

    <!-- data : polars, when SQL is not enough ; line 1 must stay `d_next = d` ; its `display` field : [labels], [table] -->
    <record id="data_polars" model="kt.kpi">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales" />
        <field name="kind">data</field>
        <field name="name">Data in polars</field>
        <field name="panel_id" ref="panel_essential" />
        <field name="sequence">17</field>
        <field name="col_span">2</field>
        <field name="tile_height">380</field>
        <field name="definition">d_next = d
# d : the rows the user may read, already filtered by the panel period and dimensions
d_next = d_next.filter(~pl.col("state").is_in(["draft", "sent", "cancel"]) &amp; pl.col("partner_id").is_not_null())
d_next = d_next.group_by("partner_id").agg([pl.len().alias("Orders"), pl.col("amount_untaxed").sum().alias("Revenue")])
# the last sort key only breaks ties : a stable order
d_next = d_next.sort(["Revenue", "partner_id"], descending=[True, False]).head(10)
d_next = d_next.rename({"partner_id": "Customer"})</field>
        <field name="display">[labels]  # the names shown : a polars tile says it here (a SQL one may too)
Customer = "Client"
Orders = "Commandes"

[table]
format = "currency"
totals = true
note = "The ten best customers, confirmed orders"

[table.columns]
Orders = { format = "integer" }
</field>
    </record>

    <!-- data : SQL inside a polars snippet (`sql(...)`, checked like a SQL tile), then polars -->
    <record id="data_sql_polars" model="kt.kpi">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales" />
        <field name="kind">data</field>
        <field name="name">Data in SQL and polars</field>
        <field name="panel_id" ref="panel_essential" />
        <field name="sequence">18</field>
        <field name="col_span">2</field>
        <field name="tile_height">380</field>
        <field name="definition">d_next = d
# SQL : the rows and the groups ; `d` is the table of the rows of the tile
d_next = sql("""
    SELECT "partner_id" AS "Customer", COUNT(*) AS "Orders", SUM("amount_untaxed") AS "Revenue"
    FROM d
    WHERE "state" NOT IN ('draft', 'sent', 'cancel') AND "partner_id" IS NOT NULL
    GROUP BY "partner_id"
""")
# polars : the rest (a table of the snippet in SQL again : sql("... FROM t", t=d_next))
d_next = d_next.with_columns(
    (pl.col("Revenue") / pl.col("Orders")).alias("Average"),
    (pl.col("Revenue") / pl.col("Revenue").sum()).alias("Share"),
)
d_next = d_next.sort(["Revenue", "Customer"], descending=[True, False]).head(10)</field>
        <field name="display">[table]
format = "currency"
note = "The ten best customers : their average order and their share of the revenue"

[table.columns]
Orders = { format = "integer" }
Share = { format = "percent", decimals = 1 }
</field>
    </record>
</odoo>
