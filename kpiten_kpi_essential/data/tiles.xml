<odoo>
    <!-- one tile per kind and option of the syntax (version 2, the union in version 1) : see the comment of each -->

    <!-- card : a count (the default aggregation) of the rows `where` keeps -->
    <record id="card_count" model="kt.dataset.line">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales" />
        <field name="kind">card</field>
        <field name="name">Count</field>
        <field name="panel_id" ref="panel_essential" />
        <field name="sequence">1</field>
        <field name="definition">version = 2
where = "state = 'sale'"
</field>
    </record>

    <!-- card : a sum, in the currency of the company, compared with the previous period -->
    <record id="card_sum" model="kt.dataset.line">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales" />
        <field name="kind">card</field>
        <field name="name">Sum</field>
        <field name="panel_id" ref="panel_essential" />
        <field name="sequence">2</field>
        <field name="definition">version = 2
where = "state = 'sale'"
measure = "amount_untaxed"
aggregation = "sum"
unit = "currency"
compare = true
</field>
    </record>

    <!-- card : a mean (no decimal unless `decimals` asks for some) -->
    <record id="card_mean" model="kt.dataset.line">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales" />
        <field name="kind">card</field>
        <field name="name">Mean</field>
        <field name="panel_id" ref="panel_essential" />
        <field name="sequence">3</field>
        <field name="definition">version = 2
where = "state = 'sale'"
measure = "amount_untaxed"
aggregation = "mean"
unit = "currency"
decimals = 0
</field>
    </record>

    <!-- card : the other aggregations (median, min, max) are written the same -->
    <record id="card_median" model="kt.dataset.line">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales" />
        <field name="kind">card</field>
        <field name="name">Median</field>
        <field name="panel_id" ref="panel_essential" />
        <field name="sequence">4</field>
        <field name="definition">version = 2
where = "state = 'sale'"
measure = "amount_untaxed"
aggregation = "median"
unit = "currency"
</field>
    </record>

    <!-- card : a column computed from two dates (`[computed]`), where fewer is better (`[compare] good`) -->
    <record id="card_derive" model="kt.dataset.line">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_purchases" />
        <field name="kind">card</field>
        <field name="name">Derived column</field>
        <field name="panel_id" ref="panel_essential" />
        <field name="sequence">5</field>
        <field name="definition">version = 2
where = "state in ('purchase', 'done')"
measure = "days_to_order"
aggregation = "mean"
unit = "days"

[compare]
good = "down"

[computed]
days_to_order = "date_approve - create_date"
</field>
    </record>

    <!-- card : the period of the panel does not apply (what is waiting now) -->
    <record id="card_ignore_period" model="kt.dataset.line">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales" />
        <field name="kind">card</field>
        <field name="name">Ignore period</field>
        <field name="panel_id" ref="panel_essential" />
        <field name="sequence">6</field>
        <field name="definition">version = 2
where = "state = 'draft'"
ignore_period = true
</field>
    </record>

    <!-- card : `from` reads another table of the store than the one of its dataset -->
    <record id="card_from" model="kt.dataset.line">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales" />
        <field name="kind">card</field>
        <field name="name">From another table</field>
        <field name="panel_id" ref="panel_essential" />
        <field name="sequence">7</field>
        <field name="definition">version = 2
where = "state = 'draft'"
from = "purchase.order"
</field>
    </record>

    <!-- card : the best group (`by`) by `measure`, with a line under it (`[detail]`) -->
    <record id="card_best" model="kt.dataset.line">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales_lines" />
        <field name="kind">card</field>
        <field name="name">Best</field>
        <field name="panel_id" ref="panel_essential" />
        <field name="sequence">8</field>
        <field name="definition">version = 2
where = "state not in ('draft', 'sent', 'cancel')"
measure = "price_subtotal"
by = "product_id"

[detail]
measure = "product_uom_qty"
label = "sold"
</field>
    </record>

    <!-- graph : bars, one per value of `by`, `measure` summed -->
    <record id="graph_bar" model="kt.dataset.line">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales" />
        <field name="kind">graph</field>
        <field name="name">Graph bar</field>
        <field name="panel_id" ref="panel_essential" />
        <field name="sequence">9</field>
        <field name="col_span">2</field>
        <field name="definition">version = 2
type = "bar"
where = "state = 'sale'"
by = "partner_id"
measure = "amount_untaxed"
aggregation = "sum"
</field>
    </record>

    <!-- graph : past the limit of bars, the rest is one « others » bar -->
    <record id="graph_bar_others" model="kt.dataset.line">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales" />
        <field name="kind">graph</field>
        <field name="name">Graph bar with others</field>
        <field name="panel_id" ref="panel_essential" />
        <field name="sequence">10</field>
        <field name="col_span">2</field>
        <field name="definition">version = 2
type = "bar"
where = "state = 'sale'"
by = "partner_id"
measure = "amount_untaxed"
aggregation = "sum"
others = true
</field>
    </record>

    <!-- graph : an area over the months (`grain` groups the dates by month) -->
    <record id="graph_area_monthly" model="kt.dataset.line">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales" />
        <field name="kind">graph</field>
        <field name="name">Graph area monthly</field>
        <field name="panel_id" ref="panel_essential" />
        <field name="sequence">11</field>
        <field name="col_span">2</field>
        <field name="definition">version = 2
type = "area"
where = "state = 'sale'"
by = "date_order"
grain = "month"
measure = "amount_untaxed"
aggregation = "sum"
</field>
    </record>

    <!-- graph : points (a scatter), `measure` counted -->
    <record id="graph_point" model="kt.dataset.line">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales_lines" />
        <field name="kind">graph</field>
        <field name="name">Graph point</field>
        <field name="panel_id" ref="panel_essential" />
        <field name="sequence">12</field>
        <field name="col_span">2</field>
        <field name="definition">version = 2
type = "point"
by = "salesman_id"
measure = "id"
aggregation = "count"
</field>
    </record>

    <!-- pivot : `rows` × `columns` (here a derived `.year`) -->
    <record id="pivot" model="kt.dataset.line">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales" />
        <field name="kind">pivot</field>
        <field name="name">Pivot</field>
        <field name="panel_id" ref="panel_essential" />
        <field name="sequence">13</field>
        <field name="col_span">2</field>
        <field name="definition">version = 2
rows = "user_id"
columns = "date_order.year"
measure = "amount_untaxed"
aggregation = "sum"
</field>
    </record>

    <!-- pivot : the dates of the rows grouped by month (`grain`) -->
    <record id="pivot_monthly" model="kt.dataset.line">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_purchases" />
        <field name="kind">pivot</field>
        <field name="name">Pivot monthly</field>
        <field name="panel_id" ref="panel_essential" />
        <field name="sequence">14</field>
        <field name="col_span">2</field>
        <field name="definition">version = 2
rows = "date_order"
columns = "date_order.year"
measure = "amount_untaxed"
aggregation = "sum"
grain = "month"
</field>
    </record>

    <!-- union (version 1) : the rows of two models, their columns mapped to the same names -->
    <record id="union" model="kt.dataset.line">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales" />
        <field name="kind">union</field>
        <field name="name">Union</field>
        <field name="panel_id" ref="panel_essential" />
        <field name="sequence">15</field>
        <field name="col_span">2</field>
        <field name="definition">union_model = "purchase.order"
[mapping."sale.order"]
name = "name"
amount_untaxed = "amount_untaxed"
[mapping."purchase.order"]
name = "name"
amount_untaxed = "amount_untaxed"
</field>
    </record>

    <!-- data : SQL on `d` ; a « [label](url) » cell is a link, a `__` column is hidden -->
    <record id="data_sql" model="kt.dataset.line">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales_lines" />
        <field name="kind">data</field>
        <field name="name">Data in SQL</field>
        <field name="panel_id" ref="panel_essential" />
        <field name="sequence">16</field>
        <field name="col_span">2</field>
        <field name="tile_height">380</field>
        <field name="definition">-- d : the rows the user may read, already filtered by the panel period and dimensions
SELECT
    '[' || "product_id" || '](' || :odoo_url || '/odoo/product.product/'
        || CAST("product_id_" AS VARCHAR) || ')' AS "Product",
    SUM("product_uom_qty") AS "Units",
    SUM("price_subtotal") AS "Revenue",
    "product_id_" AS "__product_id_"
FROM d
WHERE "state" NOT IN ('draft', 'sent', 'cancel') AND "product_id" IS NOT NULL
GROUP BY "product_id", "product_id_"
-- the product breaks the ties : a stable order
ORDER BY "Revenue" DESC, "product_id"
LIMIT 10</field>
    </record>

    <!-- data : polars, when SQL is not enough ; line 1 must stay `d_next = d` -->
    <record id="data_polars" model="kt.dataset.line">
        <field name="dataset_id" ref="kpiten_commercial_data.kpiten_sales" />
        <field name="kind">data</field>
        <field name="name">Data in polars</field>
        <field name="panel_id" ref="panel_essential" />
        <field name="sequence">17</field>
        <field name="col_span">2</field>
        <field name="tile_height">380</field>
        <field name="definition">d_next = d
# d : the rows the user may read, already filtered by the panel period and dimensions
d_next = d_next.filter(~pl.col("state").is_in(["draft", "sent", "cancel"]) &amp; pl.col("partner_id").is_not_null())
d_next = d_next.group_by("partner_id").agg([pl.len().alias("Orders"), pl.col("amount_untaxed").sum().alias("Revenue")])
# the last sort key only breaks ties : a stable order
d_next = d_next.sort(["Revenue", "partner_id"], descending=[True, False]).head(10)
d_next = d_next.rename({"partner_id": "Customer"})</field>
    </record>
</odoo>
