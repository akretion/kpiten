<odoo noupdate="1">
    <record model="ir.config_parameter" id="kpiten_staging_dir">
        <field name="key">kpiten_staging_dir</field>
        <!-- Shared-volume dir where Odoo dumps JSONL staging chunks that the
             app consolidates into the final parquets. Must point to the same
             path as the app's DATA_PATH/staging on the shared volume. -->
        <field name="value">/home/dav/dvp/dashdb/kpiten/data_dir/staging</field>
    </record>
</odoo>
