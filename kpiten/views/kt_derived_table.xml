<odoo>
    <record id="kt_derived_table_list" model="ir.ui.view">
        <field name="model">kt.derived.table</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="description" />
                <field name="source" />
                <field name="language" />
                <field name="user_id" />
                <field name="shared" />
                <field name="kpi_count" />
            </list>
        </field>
    </record>

    <record id="kt_derived_table_form" model="ir.ui.view">
        <field name="model">kt.derived.table</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group name="main">
                        <group name="left">
                            <!-- a table some KPIs read keeps its name (and stays
                                 shared) : they read it by its name -->
                            <field name="kpi_count" invisible="1" />
                            <field name="name" readonly="kpi_count" />
                            <field name="description" />
                            <field name="source" />
                            <field name="language" />
                        </group>
                        <group name="right">
                            <field name="user_id" />
                            <field
                                name="shared"
                                groups="kpiten.group_kpiten_manager"
                                readonly="kpi_count and shared"
                            />
                        </group>
                    </group>
                    <!-- the code editor has no SQL mode (Odoo 18, 20) : python for both,
                         as the SQL tiles in the form of a KPI -->
                    <field name="sql" widget="code" options="{'mode': 'python'}" />
                    <notebook>
                        <page string="Used by" name="kpis">
                            <field
                                name="kpi_ids"
                                context="{'active_test': False}"
                                nolabel="1"
                            >
                                <list decoration-muted="not active">
                                    <field name="name" />
                                    <field name="kind" />
                                    <field name="panel_ids" widget="many2many_tags" />
                                    <field name="active" column_invisible="1" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="kt_derived_table_action" model="ir.actions.act_window">
        <field name="name">Derived tables</field>
        <field name="res_model">kt.derived.table</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>
                A derived table is a query in steps on the datasets, run on the rows
                of each user. They are written and explained step by step in the
                Marimo notebook « Step by step ».
            </p>
        </field>
    </record>

    <menuitem
        id="kt_derived_table_menu"
        parent="kpiten_app"
        name="Derived tables"
        sequence="20"
        action="kt_derived_table_action"
    />
</odoo>
