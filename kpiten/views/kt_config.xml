<odoo>
    <record id="kt_config_form" model="ir.ui.view">
        <field name="model">kt.config</field>
        <field name="arch" type="xml">
            <form create="0">
                <sheet>
                    <group string="Graph defaults">
                        <group>
                            <field name="graph_title_font_color" widget="color" />
                            <field name="graph_color_1" widget="color" />
                            <field name="graph_color_2" widget="color" />
                            <field name="graph_color_3" widget="color" />
                            <field name="graph_color_4" widget="color" />
                        </group>
                        <group>
                            <field name="graph_color_5" widget="color" />
                            <field name="graph_color_6" widget="color" />
                            <field name="graph_color_7" widget="color" />
                            <field name="graph_color_8" widget="color" />
                            <field name="graph_fill_color" widget="color" />
                        </group>
                    </group>
                    <group string="Card defaults">
                        <group>
                            <field name="show_card_comparison" />
                            <field
                                name="card_good_color"
                                widget="color"
                                invisible="not show_card_comparison"
                            />
                            <field
                                name="card_bad_color"
                                widget="color"
                                invisible="not show_card_comparison"
                            />
                        </group>
                        <group
                            colspan="2"
                            invisible="not show_card_comparison"
                        >
                            <field name="card_color_preview" readonly="1" />
                        </group>
                    </group>
                    <group string="Numbers">
                        <group>
                            <field name="number_format" />
                            <field name="number_small_below" />
                            <field name="number_small_decimals" />
                            <field name="number_large_decimals" />
                        </group>
                        <group>
                            <field name="number_preview" readonly="1" />
                        </group>
                    </group>
                    <group string="Periods">
                        <field name="default_period" />
                        <field name="fiscal_year_start_month" />
                    </group>
                    <group string="Interface">
                        <field name="default_theme" />
                        <field name="table_rows" />
                    </group>
                    <group string="Explore (export of the rows)">
                        <field name="explore_access" />
                        <field
                            name="explore_max_rows"
                            invisible="explore_access == 'nobody'"
                        />
                    </group>
                    <group string="AI (marimo explorer)">
                        <field name="ai_enabled" />
                        <field name="ai_send_values" invisible="not ai_enabled" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="kt_config_act_window" model="ir.actions.act_window">
        <field name="name">Configuration</field>
        <field name="res_model">kt.config</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="kt_config_form" />
        <field name="res_id" ref="only_one" />
    </record>

    <menuitem
        id="menu_kpiten_config"
        parent="kpiten_app"
        name="Configuration"
        sequence="100"
        action="kt_config_act_window"
    />
</odoo>
