<odoo>
    <record id="kt_config_form" model="ir.ui.view">
        <field name="model">kt.config</field>
        <field name="arch" type="xml">
            <form create="0">
                <sheet>
                    <notebook>
                    <page string="Settings" name="settings">
                    <group string="Graph defaults">
                        <group>
                            <field name="colors_from" widget="radio" />
                            <field name="graph_title_font_color" widget="color" />
                            <field
                                name="graph_color_1"
                                widget="color"
                                invisible="colors_from == 'theme'"
                            />
                            <field
                                name="graph_color_2"
                                widget="color"
                                invisible="colors_from == 'theme'"
                            />
                            <field
                                name="graph_color_3"
                                widget="color"
                                invisible="colors_from == 'theme'"
                            />
                            <field
                                name="graph_color_4"
                                widget="color"
                                invisible="colors_from == 'theme'"
                            />
                        </group>
                        <group>
                            <field
                                name="graph_color_5"
                                widget="color"
                                invisible="colors_from == 'theme'"
                            />
                            <field
                                name="graph_color_6"
                                widget="color"
                                invisible="colors_from == 'theme'"
                            />
                            <field
                                name="graph_color_7"
                                widget="color"
                                invisible="colors_from == 'theme'"
                            />
                            <field
                                name="graph_color_8"
                                widget="color"
                                invisible="colors_from == 'theme'"
                            />
                            <field
                                name="graph_fill_color"
                                widget="color"
                                invisible="colors_from == 'theme'"
                            />
                        </group>
                    </group>
                    <group string="Card defaults">
                        <group>
                            <field name="show_card_comparison" />
                            <field
                                name="card_good_color"
                                widget="color"
                                invisible="not show_card_comparison or colors_from == 'theme'"
                            />
                            <field
                                name="card_bad_color"
                                widget="color"
                                invisible="not show_card_comparison or colors_from == 'theme'"
                            />
                        </group>
                        <group
                            colspan="2"
                            invisible="not show_card_comparison or colors_from == 'theme'"
                        >
                            <field name="card_color_preview" readonly="1" />
                        </group>
                    </group>
                    <group string="Numbers">
                        <group>
                            <field name="number_format" />
                            <field name="number_small_below" />
                            <field name="number_small_decimals" />
                            <field name="number_large_decimals" />
                        </group>
                        <group>
                            <field name="number_preview" readonly="1" />
                        </group>
                    </group>
                    <group>
                        <group string="Periods">
                            <field name="default_period" />
                            <field name="fiscal_year_start_month" />
                        </group>
                        <group string="Interface">
                            <field name="default_theme" />
                            <field name="table_rows" />
                        </group>
                    </group>
                    <group string="Themes of the users">
                        <field name="user_theme_ids" nolabel="1" colspan="2">
                            <list editable="bottom">
                                <field name="user_id" />
                                <field name="theme" />
                            </list>
                        </field>
                    </group>
                    <group>
                        <group string="Explore (export of the rows)">
                            <field name="explore_access" />
                            <field
                                name="explore_max_rows"
                                invisible="explore_access == 'nobody'"
                            />
                            <field
                                name="ods_max_rows"
                                invisible="explore_access == 'nobody'"
                            />
                        </group>
                        <group string="AI (marimo explorer)">
                            <field name="ai_enabled" />
                            <field name="ai_send_level" invisible="not ai_enabled" />
                        </group>
                    </group>
                    </page>
                    <page string="New features" name="new_features">
                        <div class="alert alert-info" role="alert">
                            These functions of the marimo explorer are new : each one is
                            off until you check it here.
                        </div>
                        <group>
                            <group string="Build a KPI">
                                <field name="feature_save_tile" />
                                <field name="feature_alerts" />
                                <field name="feature_concentration" />
                                <field name="feature_outliers" />
                                <field name="feature_export_ods" />
                                <field name="feature_open_in_odoo" />
                            </group>
                            <group string="AI (marimo explorer)">
                                <field name="feature_ai_refine" />
                            </group>
                        </group>
                    </page>
                    <page string="Relations" name="relations">
                        <div class="alert alert-info" role="alert">
                            The dot-paths a dashboard may follow through a many2one field
                            (e.g. <code>partner_id.category_id</code>)<br />built into kpiten
                            and its addons below, with room to add your own beside them.
                        </div>
                        <group string="Custom path relations">
                            <field
                                name="other_relations"
                                nolabel="1"
                                placeholder='{"res.partner": ["category_id"], "product.product": ["seller_ids.partner_id"]}'
                            />
                        </group>
                        <group string="Current followed paths">
                            <field name="relations_preview" readonly="1" nolabel="1" />
                        </group>
                    </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="kt_config_act_window" model="ir.actions.act_window">
        <field name="name">Configuration</field>
        <field name="res_model">kt.config</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="kt_config_form" />
        <field name="res_id" ref="only_one" />
    </record>

    <menuitem
        id="menu_kpiten_config"
        parent="kpiten_app"
        name="Configuration"
        sequence="100"
        action="kt_config_act_window"
    />
</odoo>
