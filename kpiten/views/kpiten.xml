<odoo>
    <record id="kpiten_form" model="ir.ui.view">
        <field name="model">kpiten.config</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,validated"
                    />
                </header>
                <sheet>
                    <group name="main">
                        <group name="left">
                            <field name="name" />
                            <field name="model_id" />
                        </group>
                        <group name="right">
                            <field name="group_ids" widget="many2many_tags" />
                            <field name="model_ids" widget="many2many_tags" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                    </group>
                    <group colspan="1">
                        <field name="line_ids" nolabel="1">
                            <tree>
                                <field name="definition" />
                                <field name="kind" />
                                <field name="active" optional="hide" />
                                <field name="group_ids" widget="many2many_tags" />
                            </tree>
                            <form>
                                <group>
                                    <field name="definition" />
                                    <field name="kind" widget="radio" />
                                    <field name="group_ids" widget="many2many_tags" />
                                    <field name="active" widget="boolean_toggle" />
                                </group>
                            </form>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="kpiten_list" model="ir.ui.view">
        <field name="model">kpiten.config</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="model_ids" widget="many2many_tags" />
                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    optional="show"
                    readonly="1"
                />
            </tree>
        </field>
    </record>

    <record id="kpiten_search" model="ir.ui.view">
        <field name="model">kpiten.config</field>
        <field name="arch" type="xml">
            <search>
                <filter name="name" />
            </search>
        </field>
    </record>

    <record id="kpiten_action" model="ir.actions.act_window">
        <field name="name">Kpiten</field>
        <field name="res_model">kpiten.config</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="kpiten_app"
        name="KpiTen"
        web_icon="kpiten,static/description/icon.png"
        sequence="50"
    />

    <menuitem id="kpiten_menu" parent="kpiten_app" action="kpiten_action" />
</odoo>
