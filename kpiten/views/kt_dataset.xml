<odoo>
    <record id="kt_dataset_form" model="ir.ui.view">
        <field name="model">kt.dataset</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,validated"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_lines"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-th-large"
                            invisible="not id"
                        >
                            <field
                                name="line_count"
                                widget="statinfo"
                                string="Tiles"
                            />
                        </button>
                    </div>
                    <group name="main">
                        <group name="left">
                            <field name="model_id" />
                            <field name="name" />
                        </group>
                        <group name="right">
                            <field name="group_ids" widget="many2many_tags" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                    </group>
                    <group colspan="1">
                        <field name="line_ids" nolabel="1">
                            <list
                                decoration-muted="not active"
                                decoration-danger="validation_msg"
                            >
                                <field name="sequence" widget="handle" />
                                <field name="name" />
                                <field name="kind" />
                                <field name="col_span" />
                                <field name="tile_height" />
                                <field name="group_ids" widget="many2many_tags" />
                                <field name="active" widget="boolean_toggle" />
                                <!-- read for the decoration-danger : older series check it -->
                                <field name="validation_msg" column_invisible="1" />
                            </list>
                            <kanban>
                                <templates>
                                    <t t-name="card">
                                        <field name="name" />
                                        <field name="kind" />
                                        <field name="active" optional="hide" />
                                        <field
                                            name="group_ids"
                                            widget="many2many_tags"
                                        />
                                    </t>
                                </templates>
                            </kanban>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="kt_kpi_form" model="ir.ui.view">
        <field name="model">kt.kpi</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group colspan="2">
                        <field
                            name="definition"
                            widget="ace"
                            options="{'mode': 'python'}"
                        />
                        <field
                            name="drill_definition"
                            widget="ace"
                            options="{'mode': 'python'}"
                            invisible="kind != 'data'"
                        />
                        <field
                            name="display"
                            widget="ace"
                            options="{'mode': 'python'}"
                            invisible="kind != 'data'"
                            placeholder="[labels]&#10;amount_untaxed = &quot;HT&quot;&#10;[table]&#10;format = &quot;currency&quot;&#10;totals = true"
                        />
                        <field
                            name="validation_msg"
                            string="Validation"
                            readonly="1"
                            colspan="2"
                            decoration-danger="validation_msg"
                            invisible="not validation_msg"
                            placeholder="Definition validated"
                        />
                    </group>
                </group>
                <div class="mb-3" invisible="kind != 'graph'">
                    <details>
                        <summary class="fw-bold">Syntax of a "Graph" tile</summary>
                        <div class="p-2">
                            <p>TOML. <code>by</code> and <code>measure</code> are required, the rest is optional :</p>
                            <pre>version = 2                   # optional : the syntax version 2
type = "bar"                  # bar | line | area | point | pie
from = "sale.order"           # another dataset than the tile's
where = "state = 'sale'"      # SQL on the rows (table `self`) ; {today}, {today-30}
by = "date_order"             # the x axis : a column (dotted path and date parts allowed)
grain = "month"               # a date axis grouped by month
measure = "amount_untaxed"    # the y axis
aggregation = "sum"           # sum | count | mean
others = true                 # the bars past the limit are folded into "Others"
limit = 10                    # the biggest bars kept
series = "user_id"            # one color per value of a column
stacked = true                # the series one on the other
orientation = "h"             # horizontal bars

[labels]                      # the names shown (else the labels of the fields)
amount_untaxed = "HT"

[plotly.layout]               # given as is to plotly (update_layout ; also traces)
bargap = 0.4

[computed]                    # columns computed from two dates, in whole days
days_to_order = "date_approve - create_date"</pre>
                            <ul>
                                <li>A date <code>by</code> is chronological, any other is sorted by the measure, largest first.</li>
                                <li>The tile keeps the first 50 bars (<code>TILE_MAX_CATEGORIES</code>) or the last 1000
                                    points (<code>TILE_MAX_POINTS</code>) and says so under the graph.</li>
                                <li>The period and the dimension filters of the panel apply, like the user's rights.</li>
                            </ul>
                        </div>
                    </details>
                </div>
                <div class="mb-3" invisible="kind != 'data'">
                    <details>
                        <summary class="fw-bold">Polars syntax of a "Data" tile</summary>
                        <div class="p-2">
                            <p>A restricted Python snippet on
                                <a
                                    href="https://docs.pola.rs/api/python/stable/reference/"
                                    target="_blank"
                                >polars</a>. Line 1 is <code>output = input</code> (usually
                                <code>d_next = d</code>) and must stay first ; the output must end up a table.</p>
                            <ul>
                                <li><code>d</code> : the rows the user may read, already filtered by the panel period
                                    and dimensions. <code>pl</code> : polars. <code>odoo_url</code> : the base url of Odoo.</li>
                                <li><b>Columns</b> : a many2one gives its name in <code>partner_id</code> and its id in
                                    <code>partner_id_</code> ; relational paths declared for the dataset
                                    (<code>partner_id.country_id</code>) ; date parts
                                    <code>date_order.year</code> (<code>.quarter .month .week .day</code>).</li>
                                <li><b>Links</b> : a cell <code>[label](url)</code> is drawn as a link when the url is an Odoo one,
                                    see the "Top" tiles (<code>pl.concat_str</code> with <code>odoo_url</code>).</li>
                                <li>Only the first 500 rows are shown : <code>sort</code> and <code>head</code>.</li>
                            </ul>
                            <p><b>Allowed</b> (the lists of <code>kpiten_core/sandbox.py</code>) :
                                <code>pl.col lit when sum mean count min max first last len all any int_range date_range
                                    struct list array concat concat_str sum_horizontal mean_horizontal select</code> and the
                                types ; table methods <code>filter with_columns select group_by agg sort rename cast join
                                    unique pivot limit head tail slice drop drop_nulls fill_null explode unnest sample
                                    with_row_index sql</code>... ; expression methods (aggregations, conditions, text, dates,
                                maths, windows) ; a few builtins.</p>
                            <p><b>Forbidden</b> : <code>import</code>, <code>lambda</code>, <code>def</code>,
                                <code>class</code>, loops, <code>try</code>, <code>with</code>, names starting with
                                <code>_</code>, calls outside the lists (<code>open</code>, <code>eval</code>...) and
                                Python run per row (<code>map_elements</code>, <code>apply</code>...).</p>
                        </div>
                    </details>
                </div>
                <group>
                    <group>
                        <group>
                            <field name="kind" widget="radio" />
                            <field
                                name="group_ids"
                                widget="many2many_tags"
                            />
                            <field name="user_id" />
                        </group>
                        <group>
                            <field name="name" />
                            <field name="panel_id" />
                            <field name="col_span" />
                            <field name="tile_height" />
                            <field
                                name="table_view"
                                invisible="kind not in ('data', 'pivot', 'union')"
                            />
                            <field
                                name="active"
                                widget="boolean_toggle"
                            />
                        </group>
                    </group>
                </group>
            </form>
        </field>
    </record>

    <record id="kt_kpi_list" model="ir.ui.view">
        <field name="model">kt.kpi</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active" decoration-danger="validation_msg">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="kind" />
                <field name="dataset_id" optional="hide" />
                <field name="panel_id" />
                <field name="col_span" optional="show" />
                <field name="tile_height" optional="show" />
                <field name="table_view" optional="hide" />
                <field name="group_ids" widget="many2many_tags" optional="hide" />
                <field name="user_id" optional="hide" />
                <field name="validation_msg" optional="hide" />
                <field name="xml_id" optional="hide" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record id="kt_kpi_search" model="ir.ui.view">
        <field name="model">kt.kpi</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="panel_id" />
                <field name="dataset_id" />
                <filter
                    name="archived"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
                <filter
                    name="invalid"
                    string="Invalid definition"
                    domain="[('validation_msg', '!=', False)]"
                />
                <group>
                    <filter name="by_kind" string="Kind" context="{'group_by': 'kind'}" />
                    <filter
                        name="by_panel"
                        string="Panel"
                        context="{'group_by': 'panel_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="kt_dataset_list" model="ir.ui.view">
        <field name="model">kt.dataset</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="model_id" />
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="kt_dataset_search" model="ir.ui.view">
        <field name="model">kt.dataset</field>
        <field name="arch" type="xml">
            <search>
                <field name="model_id" />
            </search>
        </field>
    </record>

    <record id="kt_dataset_action" model="ir.actions.act_window">
        <field name="name">Datasets</field>
        <field name="res_model">kt.dataset</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="kpiten_menu"
        parent="kpiten_app"
        sequence="10"
        action="kt_dataset_action"
    />
</odoo>
