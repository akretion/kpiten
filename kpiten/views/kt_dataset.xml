<odoo>
    <record id="kt_dataset_form" model="ir.ui.view">
        <field name="model">kt.dataset</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,validated"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_lines"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-th-large"
                            invisible="not id"
                        >
                            <field
                                name="line_count"
                                widget="statinfo"
                                string="Tiles"
                            />
                        </button>
                    </div>
                    <group name="main">
                        <group name="left">
                            <field name="model_id" />
                            <field name="name" />
                        </group>
                        <group name="right">
                            <field name="group_ids" widget="many2many_tags" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                    </group>
                    <group colspan="1">
                        <field name="line_ids" nolabel="1">
                            <list
                                decoration-muted="not active"
                                decoration-danger="validation_msg"
                            >
                                <field name="sequence" widget="handle" />
                                <field name="name" />
                                <field name="kind" />
                                <field name="col_span" />
                                <field name="tile_height" />
                                <field name="group_ids" widget="many2many_tags" />
                                <field name="active" widget="boolean_toggle" />
                                <!-- read for the decoration-danger : older series check it -->
                                <field name="validation_msg" column_invisible="1" />
                            </list>
                            <kanban>
                                <templates>
                                    <t t-name="card">
                                        <field name="name" />
                                        <field name="kind" />
                                        <field name="active" optional="hide" />
                                        <field
                                            name="group_ids"
                                            widget="many2many_tags"
                                        />
                                    </t>
                                </templates>
                            </kanban>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="kt_dataset_list" model="ir.ui.view">
        <field name="model">kt.dataset</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="model_id" />
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="kt_dataset_search" model="ir.ui.view">
        <field name="model">kt.dataset</field>
        <field name="arch" type="xml">
            <search>
                <field name="model_id" />
            </search>
        </field>
    </record>

    <record id="kt_dataset_action" model="ir.actions.act_window">
        <field name="name">Datasets</field>
        <field name="res_model">kt.dataset</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="kpiten_menu"
        parent="kpiten_app"
        sequence="10"
        action="kt_dataset_action"
    />
</odoo>
