<odoo>
    <record id="kpiten_panel_form" model="ir.ui.view">
        <field name="model">kt.panel</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group name="main">
                        <group name="left">
                            <field name="name" />
                            <field name="description" />
                        </group>
                        <group name="right">
                            <field name="active" widget="boolean_toggle" />
                            <field name="sequence" />
                        </group>
                    </group>
                    <field name="filter_config" widget="ace" options="{'mode': 'python'}" />
                    <notebook>
                        <page string="Tiles">
                            <field name="config_line_ids">
                                <list>
                                    <field name="sequence" widget="handle" />
                                    <field name="name" />
                                    <field name="kind" />
                                    <field name="col_span" />
                                    <field name="tile_height" />
                                    <field name="active" widget="boolean_toggle" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="kpiten_panel_kanban" model="ir.ui.view">
        <field name="model">kt.panel</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card">
                        <h4>
                            <field name="name" />
                        </h4>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="kpiten_panel_search" model="ir.ui.view">
        <field name="model">kt.panel</field>
        <field name="arch" type="xml">
            <search>
                <filter name="name" />
            </search>
        </field>
    </record>

    <record id="kpiten_panel_action" model="ir.actions.act_window">
        <field name="name">Panel</field>
        <field name="res_model">kt.panel</field>
        <field name="view_mode">kanban,form</field>
    </record>

    <menuitem
        id="kpiten_panel_menu"
        parent="kpiten.kpiten_app"
        sequence="20"
        action="kpiten_panel_action"
    />

</odoo>
