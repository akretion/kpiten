<odoo>
    <record id="kpiten_panel_form" model="ir.ui.view">
        <field name="model">kt.panel</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_new_tile"
                        type="object"
                        string="New tile"
                        icon="fa-magic"
                        class="btn-primary"
                        invisible="not id"
                        groups="kpiten.group_kpiten_manager"
                        title="Create a card, a graph or a pivot of this panel with the tile builder"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_lines"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-th-large"
                            invisible="not id"
                        >
                            <field
                                name="line_count"
                                widget="statinfo"
                                string="Tiles"
                            />
                        </button>
                    </div>
                    <group name="main">
                        <group name="left">
                            <field name="name" />
                            <field name="description" />
                        </group>
                        <group name="right">
                            <field name="active" widget="boolean_toggle" />
                            <field name="sequence" />
                        </group>
                    </group>
                    <field
                        name="filter_config"
                        widget="ace"
                        options="{'mode': 'python'}"
                    />
                    <notebook>
                        <page string="Tiles">
                            <!-- a KPI of the catalogue is added here ; removing one
                                 keeps the KPI -->
                            <field name="tile_ids">
                                <list editable="bottom" decoration-muted="not kpi_active">
                                    <field name="sequence" widget="handle" />
                                    <field name="kpi_id" />
                                    <field name="kind" />
                                    <field name="col_span" />
                                    <field name="tile_height" />
                                    <field name="kpi_active" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="kpiten_panel_kanban" model="ir.ui.view">
        <field name="model">kt.panel</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card">
                        <h4>
                            <field name="name" />
                        </h4>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="kpiten_panel_search" model="ir.ui.view">
        <field name="model">kt.panel</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
            </search>
        </field>
    </record>

    <record id="kpiten_panel_action" model="ir.actions.act_window">
        <field name="name">Panel</field>
        <field name="res_model">kt.panel</field>
        <field name="view_mode">kanban,form</field>
    </record>

    <menuitem
        id="kpiten_panel_menu"
        parent="kpiten.kpiten_app"
        sequence="20"
        action="kpiten_panel_action"
    />
</odoo>
